<style>
    div label.form-label {font-size: 13px;}
    .btn-bleu{background-color: #032F54;color: #fff;}
    .btn-bleu:hover{background-color: #04467c;color: #fff;}
</style>
<%- include("../navmenu.ejs") %>
<form class="row" id="ajoutbienimmobilier" action="/bienImmobilier" method="post">
    <% if (lesdonnees) { for (const donnee of lesdonnees){%>
    <input type="text" id="id_csca" name="id_csca" value="<%= donnee.referencecsca %>" hidden>
    <div class="form-outline mb-1 has-validation col-md-6" id="">
        <div class="input-group">
            <input value="<%= donnee.type %>" type="text" class="form-control form-control-lg shadow-sm" id="type" name="type" placeholder="Type">
        </div>
        <label for="type" class="form-label mt-1">Type</label>
    </div>
    <div class="form-outline mb-1 has-validation col-md-6" id="">
        <div class="input-group">
            <input value="<%= donnee.nature %>" type="text" class="form-control form-control-lg shadow-sm" id="nature" name="nature" placeholder="Nature">
        </div>
        <label for="nature" class="form-label mt-1">Nature</label>
    </div>
    <div class="form-outline mb-1 has-validation col-md-6" id="">
        <div class="input-group">
            <input value="<%= donnee.titre %>" type="text" class="form-control form-control-lg shadow-sm" id="titre" name="titre" placeholder="Titre">
        </div>
        <label for="titre" class="form-label mt-1">Titre</label>
    </div>
    <div class="form-outline mb-1 has-validation col-md-6" id="">
        <div class="input-group">
            <input value="<%= donnee.superficie %>" type="text" class="form-control form-control-lg shadow-sm" id="superficie" name="superficie" placeholder="Superficie">
        </div>
        <label for="superficie" class="form-label mt-1">Superficie</label>
    </div>
    <div class="form-outline mb-1 has-validation col-md-6" id="">
        <div class="input-group">
            <input value="<%= donnee.valeurestimatif %>" type="number" class="form-control form-control-lg shadow-sm" id="valeur_estimative" name="valeur_estimative" placeholder="Valeur estimative">
        </div>
        <label for="valeur_estimative" class="form-label mt-1">Valeur estimative</label>
    </div>
    <div class="text-center text-lg-start mt-4 pt-2">
        <button type="submit" class="btn btn-bleu btn-lg" style="padding-left: 2.5rem; padding-right: 2.5rem;">Enregistrer</button>
    </div>
    <%}}%>
</form>