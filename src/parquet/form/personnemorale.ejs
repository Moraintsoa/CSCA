<style>
  div label.form-label {
    font-size: 13px;
  }
  .btn-bleu {
    background-color: #032f54;
    color: #fff;
  }
  .btn-bleu:hover {
    background-color: #04467c;
    color: #fff;
  }
</style>
<%- include("../navmenu.ejs") %>
<form
  class="row"
  id="ajoutpersonnephysique"
  action="/personnemorale"
  method="post"
>
<form class="row" id="ajoutpersonnephysique" action="/personnephysique" method="post">
  <% if (lesdonnees) { for (const donnee of lesdonnees){%>
  <input type="text" id="id_csca" name="id_csca" value="<%= donnee.referencecsca %>" hidden>
  <div class="form-outline mb-1 has-validation col-md-6">
    <div class="input-group">
      <input
        value="<%= donnee.raisonsociale %>"
        type="text"
        class="form-control form-control-lg shadow-sm"
        id="raisonsociale"
        name="raisonsociale"
        placeholder="Raison sociale"
      />
    </div>
    <label for="raisonsociale" class="form-label mt-1">Raison sociale</label>
  </div>
  <div class="form-outline mb-1 has-validation col-md-6">
    <div class="input-group">
      <input
        value="<%= donnee.formejuridique %>"
        type="text"
        class="form-control form-control-lg shadow-sm"
        id="formejuridique"
        name="formejuridique"
        placeholder="Forme juridique"
      />
    </div>
    <label for="formejuridique" class="form-label mt-1">Forme juridique</label>
  </div>
  <div class="form-outline mb-1 has-validation col-md-6">
    <div class="input-group">
      <input
      value="<%= donnee.numerofiscale %>"
        type="number"
        class="form-control form-control-lg shadow-sm"
        id="numerocartefiscale"
        name="numerocartefiscale"
        placeholder="Numéro carte fiscale"
      />
    </div>
    <label for="numerocartefiscale" class="form-label mt-1"
      >Numéro carte fiscale</label
    >
  </div>
  <div class="form-outline mb-1 has-validation col-md-6">
    <div class="input-group">
      <input
      value="<%= donnee.numerocartestatistique %>"
        type="number"
        class="form-control form-control-lg shadow-sm"
        id="numerocartefiscalestatistique"
        name="numerocartefiscalestatistique"
        placeholder="Numéro carte fiscale statistique"
      />
    </div>
    <label for="numerocartefiscalestatistique" class="form-label mt-1"
      >Numéro carte fiscale statistique</label
    >
  </div>
  <div class="text-center text-lg-start mt-4 pt-2">
    <button
      type="submit"
      class="btn btn-bleu btn-lg"
      style="padding-left: 2.5rem; padding-right: 2.5rem"
    >
      Enregistrer
    </button>
  </div>
  <%}}%>
</form>
