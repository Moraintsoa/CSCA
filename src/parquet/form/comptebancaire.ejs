<style>
    div label.form-label {font-size: 13px;}
    .btn-bleu{background-color: #032F54;color: #fff;}
    .btn-bleu:hover{background-color: #04467c;color: #fff;}
</style>
<%- include("../navmenu.ejs") %>
<form class="row" id="ajoutcomptebancaire" action="/compteBancaire" method="post">
    <% if (lesdonnees) { for (const donnee of lesdonnees){%>
    <input type="text" id="id_csca" name="id_csca" value="<%= donnee.referencecsca %>" hidden>
    <div class="form-outline mb-1 has-validation col-md-6" id="">
        <div class="input-group">
            <select id="natureducompte" name="natureducompte" class="form-select form-select-lg shadow-sm" placeholder="Sélectionner...">
                <option class="select_default_value" value=""><%= donnee.naturecompte %></option>
                <option value="Banque primaire">Banque primaire</option>
                <option value="Mobile money">Mobile money</option>
                <option value="Autre etablissement financier">Autre etablissement financier</option>
            </select>
        </div>
        <label for="natureducompte" class="form-label mt-1">Nature du compte</label>
    </div>
    <div class="form-outline mb-1 has-validation col-md-6" id="">
        <div class="input-group">
            <input value="<%= donnee.numcompte %>" type="number" class="form-control form-control-lg shadow-sm" id="numerodecompte" name="numerodecompte" placeholder="Numéro de Compte">
        </div>
        <label for="numerodecompte" class="form-label mt-1">Numéro de Compte</label>
    </div>
    <div class="form-outline mb-1 has-validation col-md-6" id="">
        <div class="input-group">
            <input value="<%= donnee.domiciliations %>" type="text" class="form-control form-control-lg shadow-sm" id="domiciliations" name="domiciliations" placeholder="Domiciliations">
        </div>
        <label for="domiciliations" class="form-label mt-1">Domiciliations</label>
    </div>
    <div class="form-outline mb-1 has-validation col-md-6" id="">
        <div class="input-group">
            <input value="<%= donnee.valeurgeleestimee %>" type="number" class="form-control form-control-lg shadow-sm" id="valeurgeléeestimée" name="valeurgeleeestimee" placeholder="Valeur gelée estimée">
        </div>
        <label for="valeurgeléeestimée" class="form-label mt-1">Valeur gelée estimée</label>
    </div>
    <div class="text-center text-lg-start mt-4 pt-2">
        <button type="submit" class="btn btn-bleu btn-lg" style="padding-left: 2.5rem; padding-right: 2.5rem;">Enregistrer</button>
    </div>
    <% }} %>
</form>
