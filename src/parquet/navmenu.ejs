    <ul class="dropdown-menu p-3 listmenu">
      <!-- <li><button class="nav-link dropdown-item Dossier" id="nav-ajoutdossier-tab" data-bs-toggle="tab" data-bs-target="#nav-ajoutdossier" type="button" role="tab" aria-controls="nav-ajoutdossier" aria-selected="true"><i class="bi bi-plus-circle"></i> Dossier</button></li> -->
      <li>
        <button
          class="nav-link dropdown-item BienMobilier"
          id="nav-bienmobilier-tab"
          data-bs-toggle="tab"
          data-bs-target="#nav-bienmobilier"
          type="button"
          role="tab"
          aria-controls="nav-bienmobilier"
          aria-selected="false"
