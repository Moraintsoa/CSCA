</main>

  <script>
    const a_parquets = document.querySelectorAll("#parquet.siege")
    const a_sieges = document.querySelectorAll("#siege.parquet")
    const h1 = document.querySelector("#nombreDossier")
    const tr = document.querySelectorAll("#tbody tr")
    h1.textContent=tr.length
    a_parquets.forEach((a_parquet)=>{
      a_parquet.classList.add("d-none")
    })
    a_sieges.forEach((a_siege)=>{
      a_siege.classList.add("d-none")
    })
    function supprimer(id){
        let url_supprimer ="supprimer/"+id
        fetch(url_supprimer,{method:"DELETE"}).then((reponse)=>reponse.json()).then((donne)=>window.location.href=donne.root).catch((err)=>console.log(err))
    }
    function affichepdf(id) {
      
      // Envoyer une requête AJAX au serveur pour supprimer l'utilisateur
      fetch(`/affichepdf/${id}`, {
      method: 'POST',
    }).then((response) => {
      // Mettre à jour l'interface utilisateur en fonction de la réponse du serveur
      if (response.ok) {
        // Afficher un message de confirmation
        // Recharger la page
        window.location.reload();
      } else {
        // Afficher un message d'erreur
      }
    });
  }
  </script>