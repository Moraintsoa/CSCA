        <div class="d-flex flex-column align-items-center flex-shrink-3 py-3 px-1 bgc-bleu" id="admin_aside">
          <img src="img/profil/<%= datas[0].photo %>" alt="profil" id="admin_profil" height="120px" width="120px" class="rounded-circle border border-5"/>
          <h5 id="admin_nom" class="bgc-bleu text-white mx-auto">ADMIN</h5>
          <hr>
          <ul class="nav nav-pills flex-column mb-auto">
            <li class="nav-item Utilisateurs">
              <a href="admin?g=u&p=Utilisateurs" class="nav-link text-white listes" aria-current="page">
                <i class="bi bi-people-fill me-2" style="font-size: 1.5rem;"></i>
                <span class="text-menu col-8 p-0">Utilisateurs</span>
              </a>
            </li>
            <li class="Demandes">
              <a href="admin?g=u&p=Demandes" class="nav-link text-white listes">
                <i class="bi bi-person-fill-add me-2" style="font-size: 1.5rem;"></i>
                <% if (lesutilisateurs) {
                  let i=0;
                  for (const utilisateur of lesutilisateurs){
                    if (utilisateur.etat_du_compte==="enattente"){i++}}%>
                    <span class="text-menu col-8 p-0">Demandes
                      <% if (i>0) {%>
                      <span class="badge text-bg-primary rounded-pill align-text-bottom ms-2" ><%- i %></span>
                      <%} %>
                    </span>
                <%} %>
              </a>
            </li>
            <li class="Réinitialisation">
              <a href="admin?g=u&p=Réinitialisation" class="nav-link text-white listes">
                <i class=" bi bi-wrench-adjustable me-2" style="font-size: 1.5rem;"></i>
                <% if (lesutilisateurs) {
                  let e=0;
                  for (const utilisateur of lesutilisateurs){
                    if (utilisateur.needreinitialisation===1){e++}}%>
                    <span class="text-menu col-8 p-0">Réinitialisation
                      <% if (e>0) {%>
                      <span class="badge text-bg-warning rounded-pill align-text-bottom ms-2" ><%- e %></span>
                      <%} %>
                    </span>
                <%} %>
              </a>
            </li>
            <li class="ComptesBloqué">
              <a href="admin?g=u&p=ComptesBloqué" class="nav-link text-white listes">
                <i class="bi bi-ban me-2" style="font-size: 1.5rem;"></i>
                <span class="text-menu col-8 p-0">Comptes Bloqué</span>
              </a>
            </li>
          </ul>
          <hr>
          <div class="">
            <a href="/logoutadmin" class="d-flex align-items-center text-white text-decoration-none">
              <i class="bi bi-power text-danger me-2" style="font-size: 1.7rem;"></i>
              <span id="admin_logout" class="bgc-bleu text-white">Se deconnecter</span>
            </a>
          </div>
          <hr>
          <hr>
        </div>


