  <script>
    document.addEventListener("DOMContentLoaded",()=>{
        const urlActuelle = window.location.href;
        const urlSearchParams = new URLSearchParams(urlActuelle.split('?')[1]);
        const ajoutParam = urlSearchParams.get('p');
        document.querySelector(`li.${ajoutParam}`).classList.replace(ajoutParam,"active")
      })
  </script>