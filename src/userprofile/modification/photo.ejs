<div class="modal fade" style="background-color: rgba(255, 255, 255, 0.1);" id="photoedit" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header bgc-bleu">
          <h1 class="modal-title fs-5" id="exampleModalLabel">Photo de profile</h1>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form action="/updatephoto" enctype="multipart/form-data" method="post">
        <div class="modal-body">
          <div class="form-outline mb-1 has-validation" id="divphotoedit">
            <input type="file" id="photoedit" name="photoedit" accept="image/*" class="form-control form-control-lg shadow-sm"/>
            <label class="mt-1 form-label" for="photoedit" id="labelphoto">*.jpg, *.jpeg, *.png</label>
          </div>
        </div>
          <div class="modal-footer">
            <button type="submit" class="btn btn-bleu">Modifier</button>
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
          </div>
        </form>
      </div>
    </div>
  </div>