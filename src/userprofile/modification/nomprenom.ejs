<div class="modal fade" style="background-color: rgba(255, 255, 255, 0.1);" id="nomprenomedit" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header bgc-bleu">
          <h1 class="modal-title fs-5" id="exampleModalLabel">Nom et Prenom</h1>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form action="/updatenomprenom" method="post">
            <% if (datas) { %>
        <div class="modal-body">
          <div class="form-outline mb-1 has-validation" id="divnomedit">
            <input type="text" id="nomedit" name="nomedit" class="form-control form-control-lg shadow-sm" value="<%= datas[0].nom %>"/>
            <label class="mt-1 form-label" for="nomedit" id="labelemail">Votre nom</label>
          </div>
          <div class="form-outline mb-1 has-validation" id="divprenomedit">
            <input type="text" id="prenomedit" name="prenomedit" class="form-control form-control-lg shadow-sm" value="<%= datas[0].prenom %>"/>
            <label class="mt-1 form-label" for="prenomedit" id="labelemail">Votre prenom</label>
          </div>
        </div>
            <% } %>
          <div class="modal-footer">
            <button type="submit" class="btn btn-bleu">Modifier</button>
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
          </div>
        </form>
      </div>
    </div>
  </div>